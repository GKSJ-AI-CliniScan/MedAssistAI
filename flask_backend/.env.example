# ==========================================
# MedAssist AI - Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
FLASK_ENV=production
SECRET_KEY=generate_a_strong_secret_key_here

# Authentication
JWT_SECRET=generate_a_strong_jwt_secret_here

# MongoDB Medical Data Store (Optional / Local / Atlas)
# Example for MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/medassist_ai?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/medassist_ai

# Groq Cloud API Key (Free high-speed medical AI chat & vision assistance)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
