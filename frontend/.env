VITE_API_URL=http://localhost:8000/api

# ──────────────────────────────────────────────────────────────────────
# Google OAuth Client ID (REQUIRED for real Google Sign-In)
#
# How to get your Client ID:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new project (or select existing)
# 3. Click "Create Credentials" → "OAuth client ID"
# 4. Application type: "Web application"
# 5. Authorized JavaScript origins: http://localhost:5173
# 6. Authorized redirect URIs: http://localhost:5173
# 7. Copy the Client ID and paste it below (uncomment the line)
#
# Without this, Google Sign-In will use a development-mode manual fallback.
# ──────────────────────────────────────────────────────────────────────
# VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
