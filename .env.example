# MedAssist AI Monorepo Environment Variables Example
# Copy this file or the respective backend/.env.example and frontend/.env.example to create local .env files.

# Backend Configuration (backend/.env)
APP_NAME="MedAssistAI Backend"
APP_VERSION="1.0.0"
DEBUG=True
SECRET_KEY="your-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL="sqlite:///./medassistai.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/medassist_db"

# Frontend Configuration (frontend/.env)
VITE_API_BASE_URL="http://localhost:8000"
