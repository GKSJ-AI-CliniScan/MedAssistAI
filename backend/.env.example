# MedAssist AI — Backend Environment Variables Example

# Core Server Configuration
PROJECT_NAME="MedAssist AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Production Frontend URL (Vercel)
FRONTEND_URL="https://medassist-ai-eight.vercel.app"

# JWT Security Configuration
SECRET_KEY="medassist_a7f3k9x2p8q4w6z1n5m0r3t7y2u8v4b6c9d1e5f0g2h3j7k4l8"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL)
# Production: Use Render PostgreSQL Internal Database URL
DATABASE_URL="postgresql://user:password@host/dbname"

# CORS - Allow your Vercel frontend
CORS_ORIGINS="https://medassist-ai-eight.vercel.app"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://medassistai-1-weid.onrender.com/api/auth/google/callback"

# Microsoft Azure AD OAuth 2.0 Credentials
MICROSOFT_CLIENT_ID="your-microsoft-client-id-guid"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common"
MICROSOFT_CALLBACK_URL="https://medassistai-1-weid.onrender.com/api/auth/microsoft/callback"
