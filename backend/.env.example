# Application Configuration
APP_NAME=MedAssistAI Backend
APP_VERSION=1.0.0
DEBUG=False

# PostgreSQL Connection String (Render / Supabase / Neon / Local)
# Note: postgresql:// or postgres:// are both supported automatically
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/medassistai

# Security & JWT Configuration
SECRET_KEY=generate_a_secure_random_key_here_for_production_jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dynamic CORS Configuration (comma-separated frontend URLs)
# Vercel app domains (*.vercel.app) are automatically permitted
ALLOWED_ORIGINS=https://medassistai.vercel.app

# Server Port (Render sets this dynamically via $PORT)
PORT=8000
