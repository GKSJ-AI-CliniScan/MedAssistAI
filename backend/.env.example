# MedAssist AI Backend – Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://medassist:medassist_secret@localhost:5432/medassist_db
# Fallback SQLite for local development without PostgreSQL:
# DATABASE_URL=sqlite:///./medassist.db

# JWT Security
SECRET_KEY=your-super-secret-key-minimum-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Reports storage directory
REPORTS_DIR=./reports

# ML Model (optional – uses rule-based engine if not set)
ML_MODEL_PATH=./app/ml/models/disease_model.pkl
