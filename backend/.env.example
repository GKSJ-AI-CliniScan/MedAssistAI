# MedAssist AI — Backend Environment Variables Example

# Core Server Configuration
PROJECT_NAME="MedAssist AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:5173"

# JWT Security Configuration
SECRET_KEY="medassist_super_secret_jwt_key_987654321_prod_quality"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL / SQLite)
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password"
POSTGRES_DB="medassist_db"
POSTGRES_PORT="5432"

# Redis Cache (Optional)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8000/api/v1/auth/google/callback"

# Microsoft Azure AD OAuth 2.0 Credentials
# Obtain from Azure Portal (Microsoft Entra ID): https://portal.azure.com/#blade/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
MICROSOFT_CLIENT_ID="your-microsoft-client-id-guid"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common" # or "organizations" / your tenant GUID
MICROSOFT_CALLBACK_URL="http://localhost:8000/api/v1/auth/microsoft/callback"
