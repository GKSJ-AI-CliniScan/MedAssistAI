# Backend Environment Variables Template
APP_NAME="MedAssistAI Backend"
APP_VERSION="1.0.0"
DEBUG=True

# Security & JWT Authentication
SECRET_KEY=your-jwt-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection URL (SQLite default, or PostgreSQL)
DATABASE_URL=sqlite:///./medassistai.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medassist_db
