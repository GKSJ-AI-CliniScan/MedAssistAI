# Monorepo Root .gitignore

# Operating System
.DS_Store
Thumbs.db
*.tmp
*.log

# Environment Files
.env
.env.local
.env.development
.env.production
frontend/.env
frontend/.env.local
backend/.env

# Python Cache & Virtual Environments
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# Node & Frontend Build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user

# Machine Learning Temporary Files & Checkpoints
checkpoints/
*.checkpoint
*.tmp_model

# Docker
*.pid
backend/postgres_data/

# Databases & Local Logs
*.sqlite3
*.db
logs/
